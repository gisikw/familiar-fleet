[Unit]
Description=Familiar Fleet reverse tunnel
After=network-online.target familiar-fleet-herdr.service
Wants=network-online.target familiar-fleet-herdr.service

[Service]
Type=simple
ExecStart=%h/.nix-profile/bin/familiar-fleet --state-dir %h/.local/state/familiar-fleet tunnel
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/familiar-fleet

[Install]
WantedBy=default.target
